# install mode: local (just run the app) | dev (edit the code, live reload) | prod (deployment)
MODE=local

# absolute path of the folder storing all app data (media files, api data). Created if missing. Defaults to <project>/data
MEDIA_ROOT=

# ------------------------------- ports --------------------------------------

# port the Django app runs on
DJANGO_PORT=8001
# database port
DB_PORT=5432
# must be same as $API_PORT in .env.dev (only used for dev)
API_PORT=5001
# Redis port
REDIS_PORT=6379
# Port for SMTP (25 for unencrypted, 587 for TLS, 465 for SSL)
EMAIL_PORT=25
# Dockerized nginx entrypoint
NGINX_PORT=8080

# --------------------- credentials (blank = auto-generated) -----------------

# database name
POSTGRES_DB=demowebsite
# database user (also used as django admin user)
POSTGRES_USER=demowebsite
#  also used as django admin password (with admin username)  
POSTGRES_PASSWORD=
SECRET_KEY=

# ------------------------------ prod only -----------------------------------

# full URL of the deployed API (e.g. https://discover-api.enpc.fr)
PROD_API_URL=
# domain name of the deployed front, without scheme (e.g. aikon.enpc.fr)
PROD_URL=
# SMTP server for sending emails (e.g., 'smtp.gmail.com' or 'localhost' for local use).
EMAIL_HOST=smtp.gmail.com
# SMTP server username (usually the email address)
EMAIL_HOST_USER=admin@mail.com
# SMTP server password (password of the EMAIL_HOST_USER)
EMAIL_HOST_PASSWORD=
# Default 'From' email address for outgoing emails
DEFAULT_FROM_EMAIL=noreply@aikon-demo.fr
# List of allowed host separated by a comma
ALLOWED_HOSTS=aikon-demo.example.fr,discover.example.fr,discover-demo.example.fr
# Email where to send server-generated messages (e.g., errors, notifications)
SERVER_EMAIL=admin@mail.com

# ----------------------- advanced -----------------------

NGINX_MAX_BODY_SIZE=500M
NGINX_TIMEOUT=300
